#!/bin/bash
set -euo pipefail

echo "=== Custom installs ==="

if command -v rustup &>/dev/null; then
    echo "rustup already installed. Skipping."
else
    echo "Installing Rust toolchain via rustup..."
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh
fi

{{ if not .is_managed -}}
if command -v pi &>/dev/null; then
    echo "pi already installed. Skipping."
else
    echo "Installing pi..."
    curl -fsSL https://pi.dev/install.sh | sh
fi

{{ end -}}
{{ if eq .chezmoi.os "darwin" -}}
move_window_space_src="{{ .chezmoi.sourceDir }}/.assets/move-window-space.swift"
move_window_space_bin="$HOME/.local/bin/move-window-space"
if [ ! -x "$move_window_space_bin" ] || [ "$move_window_space_src" -nt "$move_window_space_bin" ]; then
    echo "Building move-window-space..."
    mkdir -p "$(dirname "$move_window_space_bin")"
    swiftc -O -swift-version 5 \
        "$move_window_space_src" \
        -o "$move_window_space_bin"
    chmod 755 "$move_window_space_bin"
fi

btt_preset="{{ .chezmoi.sourceDir }}/.assets/Default.bttpreset"
if [ -f "$btt_preset" ] && pgrep -x "BetterTouchTool" &>/dev/null; then
    echo "Importing BetterTouchTool preset..."
    osascript -e "tell application \"BetterTouchTool\" to import_preset \"$btt_preset\"" > /dev/null
elif [ -f "$btt_preset" ]; then
    echo "BetterTouchTool not running. Skipping preset import."
else
    echo "BTT preset file not found. Skipping."
fi

{{ end -}}
echo "Done."
